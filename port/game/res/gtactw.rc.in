// GTACTW.exe resources (configured by CMake into the build folder)
// (no #include: the constants below are written out so windres needs no include paths)

@CTW_ICON_LINE@

1 VERSIONINFO
FILEVERSION @CTW_VERSION_COMMAS@,0
PRODUCTVERSION @CTW_VERSION_COMMAS@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "kryo.to Inc"
            VALUE "FileDescription", "Grand Theft Auto: Chinatown Wars"
            VALUE "FileVersion", "@CTW_VERSION@"
            VALUE "InternalName", "GTACTW"
            VALUE "OriginalFilename", "GTACTW.exe"
            VALUE "ProductName", "Grand Theft Auto: Chinatown Wars - PC port by kryo.to"
            VALUE "ProductVersion", "@CTW_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
