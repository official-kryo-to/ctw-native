{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CTW-Native Porter",
  "version": "0.2.0",
  "identifier": "to.kryo.ctwnative.porter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CTW-Native Porter",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#050505",
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Kryoto",
    "homepage": "https://kryo.to",
    "copyright": "GPL-3.0-only"
  }
}
